# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment
.env
.env.local
.env.*.local

# Database
*.db
*.sqlite
*.sqlite3
instance/

# Logs
*.log
logs/

# Temporary
tmp/
temp/
*.tmp

# Testing
.pytest_cache/
.coverage
htmlcov/

# OS
Thumbs.db
.DS_Store

# Node (if using frontend build tools)
node_modules/
npm-debug.log
yarn-error.log
